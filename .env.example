# ─────────────────────────────────────────────
#  SafeSite AI — Master Environment Template
#  Copy to .env and fill in values
# ─────────────────────────────────────────────

# ── PostgreSQL ─────────────────────────────────
POSTGRES_DB=safesite
POSTGRES_USER=safesite_user
POSTGRES_PASSWORD=your-strong-password-here

# Full async URL (used by backend)
DATABASE_URL=postgresql+asyncpg://safesite_user:your-strong-password-here@postgres:5432/safesite

# ── Backend (FastAPI) ──────────────────────────
SECRET_KEY=your-jwt-secret-key-min-32-chars
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ── Frontend (Next.js) ─────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-nextauth-secret-min-32-chars

# ── Production images (for docker-compose.prod.yml) ─
BACKEND_IMAGE=safesite-backend:latest
FRONTEND_IMAGE=safesite-frontend:latest
